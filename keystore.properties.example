# Plantilla de la configuración de firma del APK release.
# 1. Copiar este archivo como keystore.properties (misma carpeta, raíz del proyecto).
# 2. Completar las contraseñas reales. keystore.properties NO se sube a GitHub (.gitignore).
# 3. Ejecutar: .\gradlew assembleRelease
#    El APK firmado queda en app/build/outputs/apk/release/app-release.apk
# En Windows se usan barras normales (/) en la ruta.
storeFile=C:/Users/simon/keystores/electra.jks
storePassword=CONTRASENA_DEL_KEYSTORE
keyAlias=electra
keyPassword=CONTRASENA_DE_LA_CLAVE
