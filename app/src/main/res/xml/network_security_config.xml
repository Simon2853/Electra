<?xml version="1.0" encoding="utf-8"?>
<!--
    Android bloquea HTTP sin cifrar desde la versión 9. Se permite SOLO hacia el computador de
    desarrollo visto desde el emulador (10.0.2.2) y localhost, donde corre el API Gateway sin HTTPS.
    La URL pública del túnel de VS Code ya es HTTPS, así que no necesita excepción.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
